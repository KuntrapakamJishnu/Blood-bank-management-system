#!/usr/bin/env bash
set -euo pipefail

staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"

if [[ -z "$staged_files" ]]; then
  exit 0
fi

# Block committing any .env file except .env.example
while IFS= read -r file; do
  [[ -z "$file" ]] && continue
  if [[ "$file" =~ (^|/)\.env($|\.) ]] && [[ "$file" != *.env.example ]]; then
    echo "[secret-guard] ERROR: Refusing to commit env file: $file"
    echo "[secret-guard] Keep secrets in local .env files only; do not commit them."
    exit 1
  fi
done <<< "$staged_files"

# Check only added lines in staged diff for likely credential leaks.
added_lines="$(git diff --cached -U0 --no-color | grep '^+' || true)"

if [[ -n "$added_lines" ]]; then
  # High-confidence secret patterns
  hits="$(echo "$added_lines" | grep -E "mongodb\+srv://|ghp_[A-Za-z0-9]{20,}|AIza[0-9A-Za-z_-]{20,}|sk_live_[A-Za-z0-9]{10,}|BEGIN (RSA|EC|OPENSSH) PRIVATE KEY|TWILIO_AUTH_TOKEN\s*=|SMTP_PASS\s*=|JWT_SECRET\s*=|MONGO_URI\s*=" || true)"

  # Ignore obvious placeholder/example lines
  filtered_hits="$(echo "$hits" | grep -Ev "change_this|change-me|example|<|YOUR_|your_|dummy|placeholder|MONGO_URI=\s*$|SMTP_PASS=\s*$|TWILIO_AUTH_TOKEN=\s*$|JWT_SECRET=\s*$" || true)"

  if [[ -n "$filtered_hits" ]]; then
    echo "[secret-guard] ERROR: Possible secret detected in staged changes:"
    echo "$filtered_hits"
    echo "[secret-guard] Commit blocked. Remove secrets and try again."
    exit 1
  fi
fi

echo "[secret-guard] OK: no obvious secrets detected."
exit 0
